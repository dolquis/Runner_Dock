{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runner Dock",
  "version": "0.0.0",
  "identifier": "dev.dolquis.runnerdock",
  "build": {
    "beforeDevCommand": "pnpm --filter @runnerdock/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @runnerdock/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Runner Dock",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Runner Dock contributors",
    "shortDescription": "Self-hosted GitHub Actions runner manager",
    "publisher": "dolquis"
  }
}
